{
    "manifest_version": 3,
    "name": "Secure Close",
    "version": "1.1.0",
    "description": "閲覧データを削除してから、現在のプロファイルで列挙可能な Chromium 系ブラウザーのウィンドウを閉じます。",
    "permissions": ["browsingData", "storage"],
    "incognito": "spanning",
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        }
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+Shift+C"
            }
        }
    },
    "options_page": "options/options.html",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_security_policy": {
        "extension_pages": "default-src 'self'; connect-src 'none'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
}
